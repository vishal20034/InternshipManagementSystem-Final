# ============================================
# TEN Internship Management System
# .env.environment — Template
# ============================================
# Copy this to .env and fill in the real values.
# The server reads from .env automatically.
# ============================================

# ── Server ──────────────────────────────────────
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ── MongoDB ─────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/internship-portal

# ── Email (Optional - for welcome emails) ───────
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-app-password-here
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587

# ── AI Chatbot ──────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Payment (PaymentSetu) ───────────────────────
PAYMENT_ENABLED=false
PAYMENTSETU_API_KEY=your-paymentsetu-api-key
PAYMENTSETU_SECRET_KEY=your-paymentsetu-secret-key